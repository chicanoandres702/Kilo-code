#!/usr/bin/env bash
# AIDDE - Simple one-command interface
# Usage: ./aidde "your prompt here"
set -euo pipefail

prompt="${1:-}"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ -z "$prompt" ]]; then
    echo "Usage: ./aidde \"your prompt here\"" >&2
    exit 2
fi

bash "$SCRIPT_DIR/packages/scripts/aidde-flow.sh" "$prompt"
